{
  "name": "guess-rater",
  "version": "2.0.0",
  "description": "Fuzzy string matching that just works: answer checking for quizzes, search-as-you-type, did-you-mean, fuzzy find and highlight, dedupe. Fast, zero dependencies, fully typed.",
  "keywords": [
    "fuzzy",
    "fuzzy-matching",
    "fuzzy-search",
    "string-similarity",
    "levenshtein",
    "damerau-levenshtein",
    "jaro-winkler",
    "typo",
    "autocomplete",
    "search",
    "quiz",
    "blind-test",
    "answer-checking",
    "dedupe",
    "normalize",
    "typescript",
    "highlight",
    "fuzzy-find",
    "spell-check",
    "did-you-mean"
  ],
  "license": "MIT",
  "author": "Theo Foucher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tfoucher5/guess-rater.git"
  },
  "bugs": {
    "url": "https://github.com/Tfoucher5/guess-rater/issues"
  },
  "homepage": "https://tfoucher5.github.io/guess-rater/",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs tests/*.test.cjs",
    "bench": "npm run build && node bench/bench.mjs",
    "prepublishOnly": "npm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench:real": "npm run build && node bench/real-data.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}
